# Corgi settings. The quickest start: `pnpm corgi:setup` creates .env from this file, generates the
# random secrets and asks for your keys. Every value here is yours and stays on your server.

# ── 1. Essentials ────────────────────────────────────────────────────────────────────────────────
# "sample" (default) keeps your data local; "live" adds the built-in Google OAuth mailbox (§5).
WORKSPACE_MODE=sample
# false = start empty (no fictional mailbox/calendar) and use your connected apps (§2).
SAMPLE_DATA=false
# pi = the real assistant (Impossibl models). "sample" runs scripted demo flows with no key.
AGENT_BACKEND=pi
# Impossibl key: chat, background tasks, the trust guard (Jev) and the browser navigator.
IMPOSSIBL_API_KEY=
# Default automatic model; the app can switch (see docs/MODELS.md).
# MODEL=meta/muse-spark-1.3-contributor
# IMPOSSIBL_BASE_URL=https://api.impossibl.com/v1

# The key the app asks for to open your Corgi (24+ random characters). corgi:setup generates it.
OPENMUSE_ACCESS_KEY=
# Encrypts stored credentials (Google tokens, the Apify key): 32 random bytes, base64.
TOKEN_ENCRYPTION_KEY=

PORT=8787
# 127.0.0.1 = this machine only. Behind Tailscale Serve (docs/DEPLOY.md) keep it on loopback too.
HOST=127.0.0.1
# The address you open the app at (e.g. https://<machine>.<tailnet>.ts.net).
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true
# Your time zone for "today", routines and the nightly memory reflection:
# OPENMUSE_TIMEZONE=America/Sao_Paulo
# The API also serves the exported web app (pnpm build:web:served) on the same origin:
# WEB_APP_DIR=apps/mobile/dist/web

# ── 2. Your apps ─────────────────────────────────────────────────────────────────────────────────
# Composio connects Gmail, Calendar, Slack, Notion, Drive and ~1000 more (composio.dev).
# Reads run directly; every write waits for your approval in the app.
# COMPOSIO_API_KEY=
# Apify is connected inside the app (Ajustes › Apps › Apify) with your own Apify token.

# ── 3. The assistant's browser ───────────────────────────────────────────────────────────────────
# A separate process: pnpm dev:browser (or the corgi-worker service in deploy/).
BROWSER_WORKER_URL=http://127.0.0.1:8790
# Same random 32+ character secret in the API and the browser worker. corgi:setup generates it.
WORKER_TOKEN=
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1
# What sites see (defaults pt-BR, America/Sao_Paulo):
# WORKER_LOCALE=pt-BR
# WORKER_TIMEZONE=America/Sao_Paulo
# Overrides for the browser navigator (it reuses IMPOSSIBL_API_KEY by default):
# JEV_API_KEY=
# JEV_BASE_URL=https://api.impossibl.com

# Purchases the assistant may prepare (every order still needs your tap):
# CHECKOUT_MAX_BRL=100
# CHECKOUT_MERCHANTS=ifood.com.br,mercadolivre.com.br,mercadolivre.com

# ── 4. Optional ──────────────────────────────────────────────────────────────────────────────────
# Postgres instead of the embedded database (needed for a separate task worker):
# DATABASE_URL=postgresql://...
# With a separate worker (pnpm dev:worker), set TASK_WORKER_ENABLED=false on the API.

# Private Docker Linux computer for Python and files (docs/COMPUTER.md):
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# COMPUTER_DEPLOYMENT_ID=my-corgi
# DOCKER_CONTEXT=colima-corgi

# Other model providers (AGENT_BACKEND=model) instead of Impossibl:
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# An external AG-UI agent instead of the built-in one:
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=

# ── 5. Built-in Google mailbox (optional; Composio covers Gmail/Calendar) ───────────────────────
# WORKSPACE_MODE=live plus a Google OAuth web client with Gmail and Calendar APIs enabled.
# Callback: PUBLIC_API_URL + /api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
