{
  "name": "corgi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "corgi:setup": "node scripts/setup.mjs",
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "dev:web": "pnpm --dir apps/mobile web",
    "test": "tsx --test tests/*.test.ts apps/mobile/test/*.test.ts",
    "test:browser": "node --experimental-strip-types --test apps/worker/tests/lifecycle.test.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/mobile typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/server/src/index.js",
    "build:web": "pnpm --dir apps/mobile build:web",
    "build:ios": "pnpm --dir apps/mobile build:ios",
    "build:android": "pnpm --dir apps/mobile build:android",
    "dev:worker": "tsx apps/server/src/worker-entry.ts",
    "start:worker": "node dist/apps/server/src/worker-entry.js",
    "dev:browser": "node --env-file=.env --import tsx apps/worker/src/index.ts",
    "test:computer": "tsx --test apps/computer/smoke.test.ts",
    "build:web:served": "bash apps/mobile/scripts/export-served.sh"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@composio/core": "0.20.0",
    "@copilotkit/runtime": "1.70.1",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@electric-sql/pglite": "^0.3.14",
    "@hono/node-server": "^1.19.0",
    "@napi-rs/canvas": "^1.0.9",
    "hono": "^4.11.4",
    "mammoth": "^1.12.3",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "read-excel-file": "^9.3.10",
    "rxjs": "7.8.1",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@copilotkit/core": "1.70.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
